<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>韓國行程 App</title>
    <!-- 1. 導入 Lucide 圖示腳本 -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        :root {
            --bg-color: #fdfaf7;
            --text-main: #333333;
            --text-light: #999999;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            padding: 20px;
            color: var(--text-main);
        }

        .container { max-width: 500px; margin: 0 auto; }

        .header { text-align: center; padding: 30px 0; }
        .trip-title { font-size: 22px; letter-spacing: 2px; }

        /* 2. 天氣區塊樣式 */
        /**
 * 將 Open-Meteo 代碼轉為 QWeather 圖示網址
 */
function getQWeatherIconUrl(wmoCode) {
    const baseUrl = "https://icons.qweather.com/assets/icons/";
    
    // 這裡定義 Open-Meteo(左) 對應 QWeather ID(右)
    const mapping = {
        0: "100",  // 晴
        1: "101",  // 多雲
        2: "102",  // 少雲
        3: "104",  // 陰
        45: "501", // 霧
        48: "501", // 霧
        51: "300", // 陣雨
        61: "305", // 小雨
        63: "306", // 中雨
        71: "400", // 小雪
        95: "302", // 雷陣雨
    };

    const iconId = mapping[wmoCode] || "100";
    return `${baseUrl}${iconId}.svg`;
}
        /* 3. 時間軸樣式 */
        .timeline { position: relative; padding-left: 40px; }
        .timeline::before {
            content: '';
            position: absolute;
            left: 7px;
            top: 0;
            bottom: 0;
            width: 1px;
            background: #e0e0e0;
        }

        .event { position: relative; margin-bottom: 35px; }
        .dot {
            position: absolute;
            left: -37px;
            top: 7px;
            width: 7px;
            height: 7px;
            background: #333;
            border-radius: 50%;
        }

        .time { font-size: 13px; font-weight: bold; margin-bottom: 4px; }
        .card {
            background: white;
            padding: 15px;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }
        .type { font-size: 10px; color: #a68b6d; letter-spacing: 1px; margin-bottom: 4px; }
        .location { font-size: 16px; font-weight: 500; }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div class="trip-title">KOREA 2026</div>
    </div>

    <!-- 天氣顯示區 -->
    <div class="weather-row">
        <div class="weather-item">
            <div class="weather-time">13:00</div>
            <i data-lucide="sun" class="weather-icon"></i>
            <div class="temp">22°</div>
        </div>
        <div class="weather-item">
            <div class="weather-time">14:00</div>
            <i data-lucide="cloud-sun" class="weather-icon"></i>
            <div class="temp">21°</div>
        </div>
        <div class="weather-item">
            <div class="weather-time">15:00</div>
            <i data-lucide="cloud" class="weather-icon"></i>
            <div class="temp">20°</div>
        </div>
    </div>

    <!-- 行程列表區 -->
    <div class="timeline">
        <div class="event">
            <div class="dot"></div>
            <div class="time">13:00</div>
            <div class="card">
                <div class="type">FOOD</div>
                <div class="location">在地特色餐廳</div>
            </div>
        </div>
        <div class="event">
            <div class="dot"></div>
            <div class="time">15:30</div>
            <div class="card">
                <div class="type">SIGHTSEEING</div>
                <div class="location">國技院 (Kukkiwon)</div>
            </div>
        </div>
    </div>
</div>

<!-- 4. 初始化圖示的腳本 -->
<script>
    lucide.createIcons();
</script>

</body>
</html>
